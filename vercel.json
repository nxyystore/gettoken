{
    "version": 2,
    "regions": ["iad1"],
    "redirects": [
        {
            "source": "/((?!pandora/gettoken|spotify/gettoken).*)",
            "destination": "https://nxyy.codes",
            "permanent": false
        }
    ],
    "rewrites": [
        { "source": "/pandora/gettoken", "destination": "/api/pandora" },
        { "source": "/spotify/gettoken", "destination": "/api/spotify" }
    ],
    "functions": {
        "api/spotify/index.go": {
            "memory": 1024,
            "maxDuration": 30
        },
        "api/pandora/index.go": {
            "memory": 512,
            "maxDuration": 10
        }
    }
}
